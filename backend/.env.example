# Copy this file to .env and replace the placeholder with a fresh random secret.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Defaults to backend/smartsafar.db when omitted.
# DATABASE_URL=sqlite:///C:/absolute/path/to/smartsafar.db
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional loopback URL for a self-hosted IndicTrans2 inference adapter.
# It accepts {text, source_language, target_language} using IndicTrans2 codes
# and returns {translation}. Example: http://127.0.0.1:8100/translate
# TRANSLATION_PROVIDER_URL=http://127.0.0.1:8100/translate
# TRANSLATION_PROVIDER_TIMEOUT_SECONDS=10
# Optional server-side AI Travel Assistant provider (Groq developer API).
# Create/configure your own key in Groq Console; never put it in React.
# Review Groq's current data-handling and pricing terms before enabling; requests leave SmartSafar.
# AI_PROVIDER=groq
# AI_API_KEY=
# AI_MODEL=openai/gpt-oss-20b
# AI_TIMEOUT_SECONDS=30
